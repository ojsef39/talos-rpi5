-+	if (old != ncr)
-+		macb_writel(bp, NCR, ncr);
-+
-+	return old != ncr;
-+}
-+
-+static bool macb_tx_all_queues_idle(struct macb *bp)
-+{
-+	struct macb_queue *queue;
-+	unsigned int q;
-+
-+	for (q = 0, queue = bp->queues; q < bp->num_queues; ++q, ++queue) {
-+		if (READ_ONCE(queue->tx_head) != READ_ONCE(queue->tx_tail))
-+			return false;
-+	}
-+	return true;
