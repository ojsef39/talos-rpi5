+func configureBootSelection(mountPrefix, ukiFileName string, loaderConfigFallback bool, writeVariable func(string, string) error) (bool, error) {
+	if err := writeVariable(LoaderEntryDefaultName, ukiFileName); err != nil {
+		if !loaderConfigFallback || !errors.Is(err, unix.EINVAL) {
+			return false, err
+		}
+
+		loaderConfig := fmt.Sprintf("default %s\ntimeout 5\n", ukiFileName)
+
